{
  "version": 1,
  "forge": "github",
  "framework": "nextjs",
  "packageManager": "npm",
  "runCmd": "npm run",
  "testRunner": "vitest",
  "buildDir": ".next",
  "lockfile": "package-lock.json",
  "coverageThreshold": 80,
  "scripts": {
    "dev": "dev",
    "typecheck": "typecheck",
    "lint": "lint",
    "testCoverage": "test:coverage"
  },
  "devServerUrl": "http://localhost:3000",
  "trivialDiffThreshold": 10,
  "trivialDiffPaths": ["*.md", "*.css", "*.svg", "public/**"],
  "maxFixAttempts": 2,
  "openspec": {
    "profile": "custom",
    "workflows": [
      "propose",
      "explore",
      "new",
      "continue",
      "apply",
      "update",
      "ff",
      "sync",
      "archive",
      "bulk-archive",
      "verify",
      "onboard"
    ]
  },
  "disabledRules": [],
  "sizeRouting": {
    "enabled": true
  },
  "scaffold": {
    "enabled": true
  },
  "makerChecker": {
    "enabled": false
  },
  "designSystem": {
    "enabled": true
  },
  "models": {
    "architecture": "opus",
    "spec": "opus",
    "webQa": "haiku",
    "code": "sonnet",
    "deep": "opus",
    "harness": "haiku",
    "testAuthor": "sonnet",
    "clarify": "opus",
    "default": "sonnet"
  },
  "harnessVersion": "0.12.0",
  "toolchainVerifiedAt": "2026-10-13T13:37:58Z",
  "depsAudit": "script",
  "tests": {
    "e2e": {
      "dir": "tests/web-qa-scenarios",
      "replayBeforePush": false
    }
  }
}
