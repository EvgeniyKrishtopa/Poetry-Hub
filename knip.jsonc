// implements FR-6 of add-ci-pipeline: every default issue type stays on; each ignore below carries its reason.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignore": [
    // npm-check-updates loads this config at runtime (`npm run deps:outdated`); knip has no ncu plugin to see it.
    ".ncurc.cjs",
    // Temporary, public-collections scaffold: the new stubs have no importer until their tasks wire or test them.
    // Only the new files, so knip still sees the rest of each feature. Task 7.5 removes these entries.
    "src/features/collections/**",
    // Temporary, drag-and-drop-ordering scaffold: the new stubs have no importer until their tasks wire or test them.
    // Only the new feature's files. The last group that wires the board into the route removes this entry.
    "src/features/work-ordering/**",
    // Temporary, admin-violations-feedback scaffold: the new stubs have no importer until their tasks wire or test
    // them. Only the new files, so knip still sees the rest of the admin feature. Task 6.5 removes these entries.
    "src/shared/lib/email/**",
    "src/features/admin/hooks/**",
    "src/features/admin/dal/violation-rpc.ts",
    "src/features/admin/actions/add-violation-case.actions.ts",
    "src/features/admin/actions/set-case-ground.actions.ts",
    "src/features/admin/actions/remove-violation-case.actions.ts",
    "src/features/admin/actions/send-warning.actions.ts",
    "src/features/admin/actions/send-action-notice.ts",
    "src/features/admin/model/violation*.ts",
    "src/features/admin/model/case-status.ts",
    "src/features/admin/model/action-notice-copy.ts",
    "src/features/admin/model/warning-copy.ts",
    "src/features/admin/components/AdminViolationsPage*/**",
    "src/features/admin/components/ViolationCaseRow/**",
    "src/features/admin/components/WarnDialog/**",
    "src/features/admin/components/EarlyBlockDialog/**",
    "src/features/admin/components/GroundChoiceDialog/**",
    "src/features/admin/components/ViolationDropLink/**",
    "src/features/admin/components/ViolationDndArea/**",
    "src/features/admin/components/AddToViolationsButton/**",
    "src/features/admin/components/AddToViolationsControl/**",
    "src/features/admin/components/AdminActionNotice/**"
  ],
  "ignoreDependencies": [
    // OpenSpec CLI, invoked only as `npx openspec` by the spec workflow, never imported or referenced in a script.
    "@fission-ai/openspec",
    // Supabase CLI for the local stack (`npx supabase start`, reads supabase/config.toml), never imported or referenced in a script.
    "supabase"
  ]
}
