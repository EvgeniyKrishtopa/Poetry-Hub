// implements FR-6 of add-ci-pipeline: every default issue type stays on; each ignore below carries its reason.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignore": [
    // npm-check-updates loads this config at runtime (`npm run deps:outdated`); knip has no ncu plugin to see it.
    ".ncurc.cjs",
    // Temporary, public-collections scaffold: the new stubs have no importer until their tasks wire or test them.
    // Only the new files, so knip still sees the rest of each feature. Task 7.5 removes these entries.
    "src/features/collections/**",
    // Temporary, drag-and-drop-ordering scaffold: the new stubs have no importer until their tasks wire or test them.
    // Only the new feature's files. The last group that wires the board into the route removes this entry.
    "src/features/work-ordering/**",
    // Temporary, admin-moderation scaffold: the new stubs have no importer until the route, the header slot and the
    // public pages wire them (groups 5 and 6). Only the new feature. Task 7.5 removes this entry.
    "src/features/admin/**"
  ],
  "ignoreDependencies": [
    // OpenSpec CLI, invoked only as `npx openspec` by the spec workflow, never imported or referenced in a script.
    "@fission-ai/openspec",
    // Supabase CLI for the local stack (`npx supabase start`, reads supabase/config.toml), never imported or referenced in a script.
    "supabase"
  ]
}
