// implements FR-6 of add-ci-pipeline: every default issue type stays on; each ignore below carries its reason.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignore": [
    // npm-check-updates loads this config at runtime (`npm run deps:outdated`); knip has no ncu plugin to see it.
    ".ncurc.cjs"
  ],
  // Temporary, add-breadcrumbs scaffold: these stubs and exports have no importer until the groups wire them.
  // Each entry goes in the group whose code first imports it; all of them are gone by the end of task 3.3.
  "ignoreFiles": ["src/features/breadcrumbs/**"],
  "ignoreIssues": {
    "src/features/authors/index.ts": ["exports", "types"],
    "src/features/authors/dal/public-author-name.ts": ["exports"],
    "src/shared/config/constants.ts": ["exports"],
    "src/shared/config/account-paths.ts": ["exports"]
  },
  "ignoreDependencies": [
    // OpenSpec CLI, invoked only as `npx openspec` by the spec workflow, never imported or referenced in a script.
    "@fission-ai/openspec",
    // Supabase CLI for the local stack (`npx supabase start`, reads supabase/config.toml), never imported or referenced in a script.
    "supabase"
  ]
}
