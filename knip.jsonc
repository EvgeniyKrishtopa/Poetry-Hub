// implements FR-6 of add-ci-pipeline: every default issue type stays on; each ignore below carries its reason.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignore": [
    // npm-check-updates loads this config at runtime (`npm run deps:outdated`); knip has no ncu plugin to see it.
    ".ncurc.cjs"
  ],
  // Temporary, add-privacy-policy-page scaffold: these stubs and exports have no importer until the groups wire them.
  // PRIVACY_PATH goes in group 1 (task 1.1), the entryKey props and ContentPageKey by task 2.2.
  "ignoreFiles": [
    "src/features/content-page/components/ContentPage/ContentPage.types.ts",
    "src/features/content-page/components/ContentPageContent/ContentPageContent.types.ts"
  ],
  "ignoreIssues": {
    "src/shared/config/constants.ts": ["exports"],
    "src/features/content-page/model/content-page.types.ts": ["types"]
  },
  "ignoreDependencies": [
    // OpenSpec CLI, invoked only as `npx openspec` by the spec workflow, never imported or referenced in a script.
    "@fission-ai/openspec",
    // Supabase CLI for the local stack (`npx supabase start`, reads supabase/config.toml), never imported or referenced in a script.
    "supabase"
  ]
}
