{
  "name": "poetry-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "deps:audit": "npm audit --audit-level=high",
    "deps:outdated": "ncu --errorLevel 2",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix"
  }
}
