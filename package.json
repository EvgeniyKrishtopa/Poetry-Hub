{
  "name": "poetry-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "deps:audit": "node scripts/deps-audit.mjs",
